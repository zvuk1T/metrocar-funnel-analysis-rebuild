---
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import SegmentedFunnelChart from "./SegmentedFunnelChart.astro";
import cellOutputs from "../data/cellOutputs.json";

const githubUrl = "https://github.com/zvuk1T/metrocar-funnel-analysis-rebuild";
const notebook = JSON.parse(await readFile(
  resolve(process.cwd(), "../metrocar_original_public.ipynb"), "utf8",
));
// Cell 55 contains the original Customer Funnel by platform's saved Plotly output.
const schoolFigure = notebook.cells[54].outputs.find(
  (output) => output.data?.["application/vnd.plotly.v1+json"],
).data["application/vnd.plotly.v1+json"];
const currentCustomerPlatform = cellOutputs.cells.find((output) => output.figure === "platform");
const rebuildRidePlatform = cellOutputs.cells.find((output) => output.figure === "ride-platform");

if (!currentCustomerPlatform || !rebuildRidePlatform || schoolFigure.data.length !== 3 ||
    schoolFigure.data.some((trace, index) =>
      trace.type !== "funnel" || trace.x.length !== 4 || trace.y.length !== 4 ||
      trace.name !== currentCustomerPlatform.plotlyData[index].name ||
      trace.x.some((count, stage) => count !== currentCustomerPlatform.plotlyData[index].x[stage]))) {
  throw new Error("School platform funnel no longer matches the preserved customer counts");
}

const schoolPlatform = {
  figure: "platform",
  plotlyTitle: "School Customer Funnel by platform",
  legendTitle: "Download platform",
  // Use readable stage labels while retaining the saved platform counts.
  plotlyData: schoolFigure.data.map((trace) => ({
    ...trace,
    y: currentCustomerPlatform.plotlyData[0].y,
  })),
};
---

