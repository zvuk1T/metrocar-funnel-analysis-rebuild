---
const { guide } = Astro.props;

const inlineCodeParts = (text) =>
  text.split(/(`[^`]+`)/g).filter(Boolean).map((part) => ({
    isCode: part.startsWith("`") && part.endsWith("`"),
    text: part.startsWith("`") && part.endsWith("`")
      ? part.slice(1, -1)
      : part,
  }));
---

<details class="code-guide">
  <summary>Explain this code</summary>
  <div class="code-guide-content">
    <ol class="code-guide-steps">
      {guide.steps.map((step) => (
        <li class="code-guide-step">
          <pre><code>{step.code}</code></pre>
          <p>{inlineCodeParts(step.explanation).map((part) =>
            part.isCode ? <code>{part.text}</code> : part.text
          )}</p>
        </li>
      ))}
    </ol>

    {guide.after && (
      <div class="code-guide-after">
        <span>After this cell</span>
        <p>{inlineCodeParts(guide.after).map((part) =>
          part.isCode ? <code>{part.text}</code> : part.text
        )}</p>
      </div>
    )}
  </div>
</details>
