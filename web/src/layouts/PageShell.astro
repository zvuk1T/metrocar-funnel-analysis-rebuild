---
import "../styles/global.css";
import "../styles/analysis-reading.css";
import "../styles/metrocar-dashboard.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const githubUrl =
  "https://github.com/zvuk1T/metrocar-funnel-analysis-rebuild";
const homepageBaseUrl = import.meta.env.HOMEPAGE_URL?.trim();
const homepageUrl = homepageBaseUrl
  ? new URL(homepageBaseUrl).href
  : undefined;
const projectCardUrl = homepageBaseUrl
  ? new URL("#project-metrocar", homepageBaseUrl).href
  : undefined;
---

<!doctype html>
<html lang="en" class="analysis-reading">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F3EE" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <header class="project-header shell-inner" aria-label="Metrocar case-study navigation">
      {homepageUrl ? (
        <nav class="project-return-nav" aria-label="Return to portfolio">
          <a href={homepageUrl} aria-label="Portfolio home">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7M5 9v12h5v-7h4v7h5V9" /></svg>
            <span class="project-home-label">Portfolio home</span>
          </a>
          <a class="project-card-return" href={projectCardUrl} aria-label="Back to project card">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m10 5-7 7 7 7M3 12h18" /></svg>
            <span class="project-label-long">Back to project card</span>
            <span class="project-label-short" aria-hidden="true">Project card</span>
          </a>
        </nav>
      ) : <a class="project-brand" href="#introduction">Metrocar</a>}
      <nav class="project-part-nav" aria-label="Navigate this project">
        <a href="#introduction" aria-label="Project start"><span class="project-label-long">Project start</span><span class="project-label-short" aria-hidden="true">Start</span></a>
        <a href="#dashboard">Dashboard</a>
        <a href="#full-analysis" aria-label="Full Analysis"><span class="project-label-long">Full Analysis</span><span class="project-label-short" aria-hidden="true">Analysis</span></a>
        <a href="#what-we-learned">Wrap-up</a>
      </nav>
      <nav class="project-social-links" aria-label="Project repository and contact">
        <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label="View the Metrocar repository on GitHub" title="Metrocar on GitHub"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2A10 10 0 0 0 2 12c0 4.42 2.87 8.17 6.84 9.5c.5.08.66-.23.66-.5v-1.69c-2.77.6-3.36-1.34-3.36-1.34c-.46-1.16-1.11-1.47-1.11-1.47c-.91-.62.07-.6.07-.6c1 .07 1.53 1.03 1.53 1.03c.87 1.52 2.34 1.07 2.91.83c.09-.65.35-1.09.63-1.34c-2.22-.25-4.55-1.11-4.55-4.92c0-1.11.38-2 1.03-2.71c-.1-.25-.45-1.29.1-2.64c0 0 .84-.27 2.75 1.02c.79-.22 1.65-.33 2.5-.33s1.71.11 2.5.33c1.91-1.29 2.75-1.02 2.75-1.02c.55 1.35.2 2.39.1 2.64c.65.71 1.03 1.6 1.03 2.71c0 3.82-2.34 4.66-4.57 4.91c.36.31.69.92.69 1.85V21c0 .27.16.59.67.5C19.14 20.16 22 16.42 22 12A10 10 0 0 0 12 2" /></svg><span>GitHub</span></a>
        <a href="https://www.linkedin.com/in/zarkovukovic" target="_blank" rel="noopener noreferrer" aria-label="Zarko Vukovic on LinkedIn" title="LinkedIn"><svg class="brand-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 2H3.55C2.7 2 2 2.67 2 3.5v17c0 .83.7 1.5 1.55 1.5h16.9c.85 0 1.55-.67 1.55-1.5v-17c0-.83-.7-1.5-1.55-1.5ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.1-.02-2.52-1.54-2.52-1.54 0-1.78 1.2-1.78 2.44v4.73H9.53V9.2h2.83v1.3h.04c.4-.75 1.36-1.54 2.8-1.54 3 0 3.55 1.97 3.55 4.53v5.26Z" /></svg><span>LinkedIn</span></a>
        <a href="mailto:zarko.vukovic@outlook.de" aria-label="Email Zarko Vukovic" title="Email Zarko"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 6 9 7 9-7" /></svg><span>Email</span></a>
      </nav>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="shell-inner footer-inner">
        <p>Metrocar · Analytical Case Study</p>
        <p>Master School Project</p>
      </div>
    </footer>
  </body>
</html>

<script>
  const partLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.project-part-nav a'));
  const parts = partLinks.map(link => document.getElementById(link.hash.slice(1)))
    .filter((part): part is HTMLElement => !!part);
  const outlineLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>('.analysis-outline a[href^="#"]'));
  const headings = [...new Set(outlineLinks.map(link => link.hash.slice(1)))]
    .map(id => document.getElementById(id)).filter((heading): heading is HTMLElement => !!heading)
    .sort((a, b) => a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1);
  const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-outline-group]'));
  const mobileOutline = document.querySelector<HTMLDetailsElement>('.analysis-toc-mobile');
  let activeChapter = '';
  let scheduled = false;

  function toggleGroup(group: HTMLElement, expanded: boolean) {
    const button = group.querySelector<HTMLButtonElement>(':scope > .outline-row > .outline-toggle');
    const panel = document.getElementById(button?.getAttribute('aria-controls') || '');
    if (!button || !panel) return;
    button.setAttribute('aria-expanded', String(expanded));
    panel.hidden = !expanded;
  }

  function keepCurrentLinkVisible() {
    for (const list of document.querySelectorAll<HTMLElement>('.analysis-outline > ol')) {
      const link = list.querySelector<HTMLElement>('[aria-current="location"]');
      if (!link?.getBoundingClientRect().height || !list.getBoundingClientRect().height) continue;
      const bounds = list.getBoundingClientRect();
      const linkBounds = link.getBoundingClientRect();
      if (linkBounds.top < bounds.top) list.scrollTop += linkBounds.top - bounds.top;
      else if (linkBounds.bottom > bounds.bottom) list.scrollTop += linkBounds.bottom - bounds.bottom;
    }
  }

  for (const group of groups) {
    const button = group.querySelector<HTMLButtonElement>(':scope > .outline-row > .outline-toggle');
    if (!button) continue;
    button.hidden = false;
    toggleGroup(group, false);
    button.addEventListener('click', () => {
      const expanded = button.getAttribute('aria-expanded') !== 'true';
      groups.filter(peer => peer.dataset.outlineGroup === group.dataset.outlineGroup)
        .forEach(peer => toggleGroup(peer, expanded));
    });
  }

  function updateNavigation(reveal = false) {
    scheduled = false;
    const readingLine = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--project-header-height')) + 32;
    let currentPart = parts[0];
    for (const part of parts) {
      if (part.getBoundingClientRect().top <= readingLine) currentPart = part;
      else break;
    }
    if (window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2) currentPart = parts.at(-1);
    for (const link of partLinks) {
      if (link.hash === `#${currentPart?.id}`) link.setAttribute('aria-current', 'step');
      else link.removeAttribute('aria-current');
    }

    let currentHeading = currentPart?.id === 'full-analysis' ? headings[0] : undefined;
    if (currentHeading) {
      for (const heading of headings) {
        if (heading.getBoundingClientRect().top <= readingLine) currentHeading = heading;
        else break;
      }
    }
    const chapter = outlineLinks.find(link => link.hash === `#${currentHeading?.id}`)
      ?.closest<HTMLElement>('[data-outline-group]')?.dataset.outlineGroup || '';
    if (reveal || chapter !== activeChapter) {
      activeChapter = chapter;
      // Respect a manually closed chapter until navigation or a new chapter is reached.
      groups.forEach(group => toggleGroup(group, group.dataset.outlineGroup === chapter));
    }
    for (const link of outlineLinks) {
      if (link.hash === `#${currentHeading?.id}`) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    }
    keepCurrentLinkVisible();
  }

  window.addEventListener('scroll', () => {
    if (!scheduled) { scheduled = true; requestAnimationFrame(() => updateNavigation()); }
  }, { passive: true });
  window.addEventListener('resize', () => updateNavigation());
  window.addEventListener('hashchange', () => updateNavigation(true));
  mobileOutline?.addEventListener('toggle', () => {
    if (mobileOutline?.open) keepCurrentLinkVisible();
  });

  for (const outline of document.querySelectorAll<HTMLElement>('.analysis-outline')) {
    outline.addEventListener('keydown', event => {
      if (event.key !== 'Escape' || !(event.target instanceof HTMLElement)) return;
      const group = event.target.closest<HTMLElement>('[data-outline-group]');
      const button = group?.querySelector<HTMLButtonElement>(':scope > .outline-row > .outline-toggle');
      if (group && button?.getAttribute('aria-expanded') === 'true') {
        groups.filter(peer => peer.dataset.outlineGroup === group.dataset.outlineGroup)
          .forEach(peer => toggleGroup(peer, false));
        button.focus();
      } else if (mobileOutline?.contains(outline)) {
        mobileOutline.open = false;
        mobileOutline.querySelector('summary')?.focus();
      }
      event.preventDefault();
    });
  }

  document.addEventListener('click', event => {
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey || !(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link) return;
    const target = document.getElementById(link.hash.slice(1));
    if (!target) return;
    event.preventDefault();
    if (mobileOutline) mobileOutline.open = false;
    history.pushState(null, '', link.hash);
    if (!target.hasAttribute('tabindex')) target.tabIndex = -1;
    target.focus({ preventScroll: true });
    target.scrollIntoView({ block: 'start' });
    updateNavigation(true);
  });
  updateNavigation();
</script>
